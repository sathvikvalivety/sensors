<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHistoryGhostName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/neon_green"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="👻 Casper the Inconvenient" />

            <TextView
                android:id="@+id/tvHistoryPeakScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_badge"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/neon_green"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="87% PEAK" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHistoryMood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Mood: Angry 😡 (Looking for socks)" />

        <TextView
            android:id="@+id/tvHistoryMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            tools:text="📅 30 Sep 2026 • ⏱️ 02:45 • 📍 Sector 7" />

        <TextView
            android:id="@+id/tvHistorySensors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#10FFFFFF"
            android:padding="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:typeface="monospace"
            tools:text="🧲 Mag: 85% | 📱 Mov: 70% | 🔄 Gyr: 60% | 💡 Lux: 90% | 🎤 Snd: 75% | 📏 Prox: 80%" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDeleteHistory"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🗑️ Delete"
                android:textColor="@color/danger_red"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
